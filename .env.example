# Supabase — the existing project shared with the production app.
#
# Copy this file to .env.local and fill both in. Both values are public by
# design (the anon key is a client-side key, and RLS is what protects the
# data), but they are kept out of source so the project can be pointed
# somewhere else without a code change.
#
# Find them in the Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: never add SUPABASE_SERVICE_ROLE_KEY here or to any NEXT_PUBLIC_ var.
# The service role bypasses every RLS policy; it belongs only in a
# server-side environment variable, and this app has no need for it.
